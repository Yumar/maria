# Copy to .env and adjust. Never commit .env.

# development | production
APP_ENV=development

# Address the HTTP server listens on.
HTTP_ADDR=:8080

# debug | info | warn | error
LOG_LEVEL=info

# json | text (text is only honored when APP_ENV=development)
LOG_FORMAT=json

# Postgres connection string (required).
DATABASE_URL=postgres://maria:maria@localhost:5432/maria?sslmode=disable

# true | false (default: true in development, false in production)
MIGRATE_ON_START=true
